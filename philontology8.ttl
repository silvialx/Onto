###  http://www.github.com/silvialx/Onto/EvolutionaryDebunkingArgument
ex:EvolutionaryDebunkingArgument rdf:type owl:NamedIndividual ,
                                          <http://www.github.com/argumentsontology/Argument> ;
                                 <http://www.github.com/argumentsontology/hasConclusion> ex:RealistConfidenceInMoralBeliefsIsUnjustified ;
                                 <http://www.github.com/argumentsontology/hasPremise> ex:AbsentImplausibleCoincidenceThisUndercutsRealistJustification ,
                                                                                      ex:EvolutionaryPressuresTrackReproductiveFitnessNotMindIndependentMoralTruth ,
                                                                                      ex:MoralBeliefsAreMassivelyShapedByEvolutionaryPressures ;
                                 <http://www.github.com/argumentsontology/negates> ex:NonReductiveNaturalism ,
                                                                                   ex:Nonnaturalism ;
                                 <http://www.github.com/argumentsontology/supports> ex:HumeanConstructivism ;
                                 rdfs:label "our moral beliefs are massively shaped by evolutionary pressures that track reproductive fitness, not mind-independent moral truth; absent an implausible coincidence, this undercuts the justification for realist confidence in those beliefs (Street)." .


