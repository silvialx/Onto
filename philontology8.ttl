#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( ex:Coherentist
                        ex:Empiricist
                        ex:Fictionalist
                        ex:Intuitionist
                        ex:QuasiRealist
                        ex:Skeptic
                      )
] .


#################################################################
#    Rules
#################################################################

:pos rdf:type swrl:Variable .

:supp1 rdf:type swrl:Variable .

:supp2 rdf:type swrl:Variable .

:position rdf:type swrl:Variable .

:supp rdf:type swrl:Variable .

:condition rdf:type swrl:Variable .

:school rdf:type swrl:Variable .

:author rdf:type swrl:Variable .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "Incompatibility (for inferring inconsistency)" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                           swrl:argument1 :pos ;
                           swrl:argument2 :supp1
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                                      swrl:argument1 :pos ;
                                      swrl:argument2 :supp2
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate ex:isIncompatibleWith ;
                                                 swrl:argument1 :supp1 ;
                                                 swrl:argument2 :supp2
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate ex:MetaethicalPosition ;
                                                            swrl:argument1 :pos
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate ex:isIncompatibleWith ;
                           swrl:argument1 :pos ;
                           swrl:argument2 :supp1
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "if an argument requires necessarily a condition and is not inconsistent, then it is a conditionally consistent argument." ;
   rdfs:label "conditionnally consistent positions" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                           swrl:argument1 :position ;
                           swrl:argument2 :supp
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate ex:necessaryCondition ;
                                      swrl:argument1 :supp ;
                                      swrl:argument2 :condition
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate ex:MetaethicalPosition ;
                                                 swrl:argument1 :position
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate :ConditionallyConsistentPosition ;
                           swrl:argument1 :position
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "if a school requires some suppositions, the authors belonging to that school commit to those suppositions as well." ;
   rdfs:label "supposition simmetry 1" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                           swrl:argument1 :school ;
                           swrl:argument2 :supp
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate <http://www.github.com/argumentsontology/supports> ;
                                      swrl:argument1 :author ;
                                      swrl:argument2 :school
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate ex:MetaethicalPosition ;
                                                 swrl:argument1 :school
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate ex:Philosopher ;
                                                            swrl:argument1 :author
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                           swrl:argument1 :author ;
                           swrl:argument2 :supp
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "if a position is supported by an argument whose two declared suppositions are incompatible with each other, the position is inconsistent." ;
   rdfs:label "inconsistent position" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                           swrl:argument1 :position ;
                           swrl:argument2 :supp1
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate <http://www.github.com/argumentsontology/hasSupposition> ;
                                      swrl:argument1 :position ;
                                      swrl:argument2 :supp2
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate ex:isIncompatibleWith ;
                                                 swrl:argument1 :supp1 ;
                                                 swrl:argument2 :supp2
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate :InconsistentPosition ;
                           swrl:argument1 :position
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

