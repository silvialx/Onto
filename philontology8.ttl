###  http://www.github.com/silvialx/Onto/HybridExpressivism
ex:HybridExpressivism rdf:type owl:NamedIndividual ,
                               ex:ConsistentPosition ,
                               ex:MetaethicalPosition ;
                      ex:actionMotivationSupposition ex:Internalist ;
                      ex:cognitivistSupposition ex:HybridTheorist ;
                      ex:epistemicSupposition ex:QuasiRealist ;
                      ex:metaphysicalSupposition ex:Antirealist ;
                      ex:necessaryCondition ex:truthMinimalism ;
                      ex:representationSupposition ex:Antirepresentationalist ;
                      ex:truthAptnessSupposition ex:TruthApt ;
                      rdfs:comment "moral assertions express a hybrid state with both descriptive and desire-like/expressive components, aiming to capture the truth-aptness of moral discourse while retaining an expressivist explanation of moral motivation (Ridge's ecumenical expressivism)." .


###  http://www.github.com/silvialx/Onto/HybridTheorist
ex:HybridTheorist rdf:type owl:NamedIndividual ,
                           ex:Cognitivism ;
                  ex:isConditionallyCompatibleWith ex:Cognitivist ,
                                                   ex:Noncognitivist ;
                  skos:definition "Hybrid theorism holds that moral judgments are hybrid states, combining belief-like descriptive content with attitude-like conative/expressive content (Ridge's ecumenical expressivism, Boisvert)." .


###  http://www.github.com/silvialx/Onto/IdealObserverTheory
ex:IdealObserverTheory rdf:type owl:NamedIndividual ,
                                ex:ConsistentPosition ,
                                ex:MetaethicalPosition ;
                       ex:actionMotivationSupposition ex:Internalist ;
                       ex:cognitivistSupposition ex:Cognitivist ;
                       ex:epistemicSupposition ex:Empiricist ;
                       ex:metaphysicalSupposition ex:Subjectivist ;
                       ex:representationSupposition ex:Representationalist ;
                       ex:truthAptnessSupposition ex:TruthApt ;
                       rdfs:comment "x is good iff an ideal (fully informed, impartial, dispassionate) observer would approve of x; moral facts are mind-dependent but not arbitrary (Firth)." .


###  http://www.github.com/silvialx/Onto/IfExpressivistsCanAssertEverythingRealistsAssertTheDisputeLosesSubstantiveContent
