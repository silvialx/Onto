ex:NonnaturalRealism rdf:type owl:NamedIndividual ,
                              ex:Metaphysics ;
                     ex:isIncompatibleWith ex:Antirealist ,
                                           ex:Antirepresentationalist ,
                                           ex:Empiricist ,
                                           ex:Fictionalist ,
                                           ex:NaturalRealism ,
                                           ex:NonTruthApt ,
                                           ex:Noncognitivist ,
                                           ex:QuasiRealist ,
                                           ex:Skeptic ;
                     skos:definition "Nonnatural realism holds that, even though ethical facts are part of reality, they are not natural facts." .


