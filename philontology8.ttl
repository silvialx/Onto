###  http://www.github.com/silvialx/Onto/FregeGeachProblem
ex:FregeGeachProblem rdf:type owl:NamedIndividual ,
                              <http://www.github.com/argumentsontology/Argument> ;
                     <http://www.github.com/argumentsontology/hasConclusion> ex:MoralJudgmentsAreBeliefsNotAttitudes ;
                     <http://www.github.com/argumentsontology/hasPremise> ex:MoralSentencesRetainTheSameMeaningWhenEmbeddedInUnassertedContexts ,
                                                                          ex:NoncognitivistAnalysesExplainMoralUtterancesAsExpressionsOfAttitudeRatherThanTruthAptClaims ,
                                                                          ex:OrdinaryMoralInferencesLikeModusPonensDependOnThisConstancyOfMeaning ;
                     <http://www.github.com/argumentsontology/negates> ex:BlackburnExpressivism ,
                                                                       ex:Emotivism ,
                                                                       ex:GibbardNormExpressivism ,
                                                                       ex:Prescriptivism ;
                     <http://www.github.com/argumentsontology/supports> ex:Cognitivist ;
                     rdfs:label "moral sentences keep the same meaning when embedded in unasserted contexts, such as the antecedent of a conditional, as they have when asserted outright, which is what makes ordinary moral inferences (modus ponens) valid; noncognitivist analyses, which explain moral utterances as expressions of attitude rather than truth-apt claims, struggle to explain this constancy of meaning across asserted and unasserted occurrences (Geach, following Frege)." .


