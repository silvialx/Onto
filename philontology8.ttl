###  http://www.github.com/silvialx/Onto/QuasiRealist
ex:QuasiRealist rdf:type owl:NamedIndividual ,
                         ex:Epistemology ;
                ex:isConditionallyCompatibleWith ex:Realist ;
                ex:isIncompatibleWith ex:Cognitivist ,
                                      ex:Empiricist ,
                                      ex:Intuitionist ,
                                      ex:NaturalRealism ,
                                      ex:NonnaturalRealism ,
                                      ex:truthCorrespondentism ;
                ex:necessaryCondition ex:truthMinimalism ;
                skos:definition "Quasi-realism claims that although it is not wrong to claim statements such as \"it is a fact that lying is wrong\", but it would be wrong to say that ethical statement belong to a full an final metaphysical representation of what reality is like." .


###  http://www.github.com/silvialx/Onto/QuasiRealistsCanEarnTheRightToEveryRealistSoundingSentence
