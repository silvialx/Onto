###  http://www.github.com/silvialx/Onto/NormativeAuthorityMustBeConstitutedByRationalSelfLegislation
ex:NormativeAuthorityMustBeConstitutedByRationalSelfLegislation rdf:type owl:NamedIndividual ,
                                                                         <http://www.github.com/argumentsontology/Claim> ;
                                                                rdfs:label "The authority of moral requirements must be constituted by an agent's own rational self-legislation."@en .


###  http://www.github.com/silvialx/Onto/NormativeConclusionsStateWhatOughtToBeTheCase
ex:NormativeConclusionsStateWhatOughtToBeTheCase rdf:type owl:NamedIndividual ,
                                                          <http://www.github.com/argumentsontology/Claim> ;
                                                 rdfs:label "Normative conclusions state what ought to be the case."@en .


###  http://www.github.com/silvialx/Onto/NormativityRegressArgument
ex:NormativityRegressArgument rdf:type owl:NamedIndividual ,
                                       <http://www.github.com/argumentsontology/Argument> ;
                              <http://www.github.com/argumentsontology/hasConclusion> ex:NormativeAuthorityMustBeConstitutedByRationalSelfLegislation ;
                              <http://www.github.com/argumentsontology/hasPremise> ex:GroundingMoralAuthorityInAFurtherFactInvitesTheQuestionOfWhatGroundsThatFact ,
                                                                                   ex:OnlySelfLegislatedRequirementsOfRationalAgencyAvoidTheRegress ,
                                                                                   ex:ThisQuestionThreatensAnInfiniteRegressOrABruteStoppingPoint ;
                              <http://www.github.com/argumentsontology/negates> ex:Nonnaturalism ,
                                                                                ex:Realist ;
                              <http://www.github.com/argumentsontology/supports> ex:KantianConstructivism ,
                                                                                 ex:QuietistMetaethics ;
                              rdfs:label "any attempt to ground the authority of moral requirements in a further fact threatens a regress or a brute stopping point; only requirements that are self-legislated by rational agency avoid this regress, motivating a constructivist account of normativity (Korsgaard)." .


