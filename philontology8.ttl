###  http://www.github.com/silvialx/Onto/ParfitTrivialityObjection
ex:ParfitTrivialityObjection rdf:type owl:NamedIndividual ,
                                      <http://www.github.com/argumentsontology/Argument> ;
                             <http://www.github.com/argumentsontology/hasConclusion> ex:TheExpressivistRealistDisputeBecomesMerelyVerbalOrTrivial ;
                             <http://www.github.com/argumentsontology/hasPremise> ex:CreepingMinimalismErodesAnyRemainingDifferenceBetweenTheViews ,
                                                                                  ex:IfExpressivistsCanAssertEverythingRealistsAssertTheDisputeLosesSubstantiveContent ,
                                                                                  ex:QuasiRealistsCanEarnTheRightToEveryRealistSoundingSentence ;
                             <http://www.github.com/argumentsontology/negates> ex:BlackburnExpressivism ,
                                                                               ex:GibbardNormExpressivism ;
                             rdfs:label "quasi-realist expressivists can 'earn the right' to every realist-sounding sentence, making the dispute between expressivism and realism merely verbal or trivial once creeping minimalism has run its course (Parfit's objection to quasi-realism)." .


###  http://www.github.com/silvialx/Onto/Particularism
ex:Particularism rdf:type owl:NamedIndividual ,
                          ex:ConsistentPosition ,
                          ex:MetaethicalPosition ;
                 ex:actionMotivationSupposition ex:Internalist ;
                 ex:cognitivistSupposition ex:Cognitivist ;
                 ex:epistemicSupposition ex:Intuitionist ;
                 ex:metaphysicalSupposition ex:Realist ;
                 ex:representationSupposition ex:Representationalist ;
                 ex:truthAptnessSupposition ex:TruthApt ;
                 rdfs:comment "the moral relevance of a feature is holistic and context-sensitive; there need be no finite set of exceptionless general principles codifying right action (Dancy)." .


###  http://www.github.com/silvialx/Onto/PositsThatNeverExplainAnythingGiveNoReasonToBelieveInThem
ex:PositsThatNeverExplainAnythingGiveNoReasonToBelieveInThem rdf:type owl:NamedIndividual ,
                                                                      <http://www.github.com/argumentsontology/Claim> ;
                                                             rdfs:label "Positing entities that never feature in any best explanation gives us no reason to believe those entities exist."@en .


###  http://www.github.com/silvialx/Onto/Prescriptivism
ex:Prescriptivism rdf:type owl:NamedIndividual ,
                           ex:ConsistentPosition ,
                           ex:MetaethicalPosition ;
                  ex:actionMotivationSupposition ex:Internalist ;
                  ex:cognitivistSupposition ex:Noncognitivist ;
                  ex:epistemicSupposition ex:Skeptic ;
                  ex:metaphysicalSupposition ex:Antirealist ;
                  ex:representationSupposition ex:Antirepresentationalist ;
                  ex:truthAptnessSupposition ex:NonTruthApt ;
                  rdfs:comment "moral judgments are universalizable prescriptions (a species of imperative), not descriptions; to judge that one ought to phi is to prescribe, universally, that one phi (Hare)." .


