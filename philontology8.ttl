                          fabio:Book ;
                 schema:about ex:Nonnaturalism ,
                              ex:ParfitTrivialityObjection ;
                 schema:datePublished 2011 .


###  http://www.github.com/silvialx/Onto/OnlySelfLegislatedRequirementsOfRationalAgencyAvoidTheRegress
ex:OnlySelfLegislatedRequirementsOfRationalAgencyAvoidTheRegress rdf:type owl:NamedIndividual ,
                                                                          <http://www.github.com/argumentsontology/Claim> ;
                                                                 rdfs:label "Only requirements that are self-legislated by rational agency avoid this regress."@en .


###  http://www.github.com/silvialx/Onto/OpenQuestionArgument
ex:OpenQuestionArgument rdf:type owl:NamedIndividual ,
                                 <http://www.github.com/argumentsontology/Argument> ;
                        <http://www.github.com/argumentsontology/hasConclusion> ex:GoodCannotBeAnalyticallyIdenticalToAnyNaturalProperty ;
                        <http://www.github.com/argumentsontology/hasPremise> ex:ForAnyProposedNaturalPropertyItRemainsASignificantOpenQuestionWhetherThatWhichHasItIsGood ,
                                                                             ex:IfGoodMeantThatPropertyAnalyticallyTheQuestionWouldBeTrivialOrClosed ,
                                                                             ex:TheQuestionIsNeverTrivialOrClosedForAnyProposedNaturalProperty ;
                        <http://www.github.com/argumentsontology/negates> ex:NaturalRealism ,
                                                                          ex:ReductiveNaturalism ;
                        <http://www.github.com/argumentsontology/supports> ex:BlackburnExpressivism ,
                                                                           ex:Emotivism ,
                                                                           ex:Nonnaturalism ;
                        rdfs:label "for any proposed natural property N that 'good' is claimed to mean, it remains a significant, open question whether something that is N is also good, whereas a genuine analytic identity would make the question trivial or closed; this shows 'good' cannot be reductively defined in natural terms (Moore, against reductive naturalism)." .


###  http://www.github.com/silvialx/Onto/OrdinaryMoralInferencesLikeModusPonensDependOnThisConstancyOfMeaning
ex:OrdinaryMoralInferencesLikeModusPonensDependOnThisConstancyOfMeaning rdf:type owl:NamedIndividual ,
                                                                                 <http://www.github.com/argumentsontology/Claim> ;
                                                                        rdfs:label "Ordinary moral inferences, such as modus ponens, depend on this constancy of meaning across asserted and unasserted occurrences."@en .


