                     ex:Metaphysics ;
            ex:isIncompatibleWith ex:Antirealist ,
                                  ex:Realist ;
            skos:definition "Quiteism rejects the realism/anti-realism question itself as confused or as collapsing into first-order ethical claims once properly understood (a Wittgensteinian/Scanlonian move)." .


###  http://www.github.com/silvialx/Onto/QuietistMetaethics
ex:QuietistMetaethics rdf:type owl:NamedIndividual ,
                               ex:ConsistentPosition ,
                               ex:MetaethicalPosition ;
                      ex:cognitivistSupposition ex:Cognitivist ;
                      ex:epistemicSupposition ex:ReflectiveEquilibriumist ;
                      ex:metaphysicalSupposition ex:Quietist ;
                      ex:representationSupposition ex:Representationalist ;
                      ex:truthAptnessSupposition ex:TruthApt ;
                      rdfs:comment "first-order moral claims can be fully warranted without answering, or even needing to answer, the traditional metaphysical question of whether moral facts are 'mind-independent'; the question itself may rest on a confusion." .


