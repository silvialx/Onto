@prefix : <http://www.semanticweb.org/silvi/ontologies/2026/6/untitled-ontology-6#> .
@prefix ex: <http://www.github.com/silvialx/Onto/> .
@prefix ns1: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix argo: <http://www.github/argumentsontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.semanticweb.org/silvi/ontologies/2026/6/untitled-ontology-6#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
swrla:isRuleEnabled rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:ObjectProperty ;
                owl:inverseOf ex:created ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( fabio:BookChapter
                                            <http://www.github.com/argumentsontology/Argument>
                                          )
                            ] ;
                rdfs:range ex:Philosopher .


###  http://purl.org/spar/cito/disagreesWith
<http://purl.org/spar/cito/disagreesWith> rdf:type owl:ObjectProperty .


###  http://purl.org/spar/cito/disputes
<http://purl.org/spar/cito/disputes> rdf:type owl:ObjectProperty .


###  http://purl.org/spar/cito/refutes
<http://purl.org/spar/cito/refutes> rdf:type owl:ObjectProperty .


###  http://purl.org/spar/cito/supports
<http://purl.org/spar/cito/supports> rdf:type owl:ObjectProperty .


###  http://www.github.com/argumentsontology/contradicts
<http://www.github.com/argumentsontology/contradicts> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <http://purl.org/spar/cito/disputes> ,
                                                                         <http://www.github.com/argumentsontology/opposes> ;
                                                      owl:inverseOf <http://www.github.com/argumentsontology/isContradictedBy> .


###  http://www.github.com/argumentsontology/hasConclusion
<http://www.github.com/argumentsontology/hasConclusion> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf ex:conclusionOf ;
                                                        rdfs:domain <http://www.github.com/argumentsontology/Argument> ;
                                                        rdfs:range <http://www.github.com/argumentsontology/Claim> ;
                                                        rdfs:label "has conclusion"@en .


###  http://www.github.com/argumentsontology/hasPremise
<http://www.github.com/argumentsontology/hasPremise> rdf:type owl:ObjectProperty ;
                                                     owl:inverseOf ex:premiseOf ;
                                                     rdfs:domain <http://www.github.com/argumentsontology/Argument> ;
                                                     rdfs:range <http://www.github.com/argumentsontology/Claim> ;
                                                     rdfs:label "has premise"@en .


###  http://www.github.com/argumentsontology/hasSupposition
<http://www.github.com/argumentsontology/hasSupposition> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain [ rdf:type owl:Class ;
                                                                       owl:unionOf ( <http://www.github.com/argumentsontology/Argument>
                                                                                     ex:Philosopher
                                                                                   )
                                                                     ] .


###  http://www.github.com/argumentsontology/isContradictedBy
<http://www.github.com/argumentsontology/isContradictedBy> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <http://www.github.com/argumentsontology/isOpposedBy> .


###  http://www.github.com/argumentsontology/isNegatedBy
<http://www.github.com/argumentsontology/isNegatedBy> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <http://www.github.com/argumentsontology/isOpposedBy> ;
                                                      owl:inverseOf <http://www.github.com/argumentsontology/negates> .


###  http://www.github.com/argumentsontology/isOpposedBy
<http://www.github.com/argumentsontology/isOpposedBy> rdf:type owl:ObjectProperty ;
                                                      owl:inverseOf <http://www.github.com/argumentsontology/opposes> .


###  http://www.github.com/argumentsontology/isSupportedBy
<http://www.github.com/argumentsontology/isSupportedBy> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf <http://www.github.com/argumentsontology/supports> .


###  http://www.github.com/argumentsontology/negates
<http://www.github.com/argumentsontology/negates> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://purl.org/spar/cito/refutes> ,
                                                                     <http://www.github.com/argumentsontology/opposes> .


###  http://www.github.com/argumentsontology/opposes
<http://www.github.com/argumentsontology/opposes> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://purl.org/spar/cito/disagreesWith> .


###  http://www.github.com/argumentsontology/supports
<http://www.github.com/argumentsontology/supports> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://purl.org/spar/cito/supports> .


###  http://www.github.com/silvialx/Onto/actionMotivationSupposition
ex:actionMotivationSupposition rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                               rdfs:range ex:ActionMotivation .


###  http://www.github.com/silvialx/Onto/cognitivistSupposition
ex:cognitivistSupposition rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                          rdfs:range ex:Cognitivism .


###  http://www.github.com/silvialx/Onto/conclusionOf
ex:conclusionOf rdf:type owl:ObjectProperty .


###  http://www.github.com/silvialx/Onto/created
ex:created rdf:type owl:ObjectProperty ;
           rdfs:domain ex:Philosopher ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( fabio:BookChapter
                                      <http://www.github.com/argumentsontology/Argument>
                                    )
                      ] .


###  http://www.github.com/silvialx/Onto/epistemicSupposition
ex:epistemicSupposition rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                        rdfs:range ex:Epistemology .


###  http://www.github.com/silvialx/Onto/isConditionallyCompatibleWith
ex:isConditionallyCompatibleWith rdf:type owl:ObjectProperty ,
                                          owl:SymmetricProperty .


###  http://www.github.com/silvialx/Onto/isIncompatibleWith
ex:isIncompatibleWith rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( ex:Axis
                                                  ex:MetaethicalPosition
                                                )
                                  ] ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( ex:Axis
                                                 ex:MetaethicalPosition
                                               )
                                 ] .


###  http://www.github.com/silvialx/Onto/metaphysicalSupposition
ex:metaphysicalSupposition rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                           rdfs:range ex:Metaphysics .


###  http://www.github.com/silvialx/Onto/necessaryCondition
ex:necessaryCondition rdf:type owl:ObjectProperty .


###  http://www.github.com/silvialx/Onto/premiseOf
ex:premiseOf rdf:type owl:ObjectProperty .


###  http://www.github.com/silvialx/Onto/representationSupposition
ex:representationSupposition rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                             rdfs:range ex:Representationalism .


###  http://www.github.com/silvialx/Onto/truthAptnessSupposition
ex:truthAptnessSupposition rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.github.com/argumentsontology/hasSupposition> ;
                           rdfs:range ex:TruthAptness .


###  http://www.github/argumentsontology/rebuts
argo:rebuts rdf:type owl:ObjectProperty .


###  https://schema.org/about
schema:about rdf:type owl:ObjectProperty ;
             owl:inverseOf schema:subjectOf .


###  https://schema.org/subjectOf
schema:subjectOf rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://schema.org/datePublished
schema:datePublished rdf:type owl:DatatypeProperty ;
                     rdfs:domain ex:BibliographicEntity ;
                     rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/fabio/Book
fabio:Book rdf:type owl:Class ;
           rdfs:subClassOf ex:BibliographicEntity .


###  http://purl.org/spar/fabio/BookChapter
fabio:BookChapter rdf:type owl:Class ;
                  rdfs:subClassOf ex:BibliographicEntity .


###  http://www.github.com/argumentsontology/Argument
<http://www.github.com/argumentsontology/Argument> rdf:type owl:Class ;
                                                   rdfs:comment "A philosophical argument put forward by one or more philosophers, which supports and/or negates one or more metaethical positions." ;
                                                   rdfs:label "Argument"@en .


###  http://www.github.com/argumentsontology/Claim
<http://www.github.com/argumentsontology/Claim> rdf:type owl:Class ;
                                                rdfs:comment "A single proposition that functions as a premise or conclusion within one or more Arguments. The same Claim individual may serve as a premise in one Argument and a conclusion (or premise) in another." ;
                                                rdfs:label "Claim"@en .


###  http://www.github.com/silvialx/Onto/ActionMotivation
ex:ActionMotivation rdf:type owl:Class ;
                    rdfs:subClassOf ex:PhilosophyOfMind .


###  http://www.github.com/silvialx/Onto/Axis
ex:Axis rdf:type owl:Class ;
        rdfs:comment "The four pillars our definitions rely upon." .


###  http://www.github.com/silvialx/Onto/BibliographicEntity
ex:BibliographicEntity rdf:type owl:Class .


###  http://www.github.com/silvialx/Onto/Cognitivism
ex:Cognitivism rdf:type owl:Class ;
               rdfs:subClassOf ex:PhilosophyOfMind ;
               rdfs:comment "the elements of this class will classify different stances on the following question: does the state of mind expressed by an ethical statement correspond to a belief about how reality ought to be, or does it rather correspond to a certain attitude, such as outrage or praise?" .


###  http://www.github.com/silvialx/Onto/ConsistentPosition
ex:ConsistentPosition rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ex:MetaethicalPosition
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty ex:isIncompatibleWith ;
                                                                   owl:cardinality "0"^^xsd:nonNegativeInteger
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ex:EvaluatedPosition ;
                      owl:disjointWith :InconsistentPosition .


###  http://www.github.com/silvialx/Onto/Epistemology
ex:Epistemology rdf:type owl:Class ;
                rdfs:subClassOf ex:Axis ;
                rdfs:comment "the epistemic view determines the answer to the following question: can ethical facts be learned through empirical investigation?" .


###  http://www.github.com/silvialx/Onto/EvaluatedPosition
ex:EvaluatedPosition rdf:type owl:Class .


###  http://www.github.com/silvialx/Onto/Expressivism
ex:Expressivism rdf:type owl:Class ;
                rdfs:subClassOf ex:MetaethicalPosition .


###  http://www.github.com/silvialx/Onto/MetaethicalPosition
ex:MetaethicalPosition rdf:type owl:Class .


###  http://www.github.com/silvialx/Onto/Metaphysics
ex:Metaphysics rdf:type owl:Class ;
               rdfs:subClassOf ex:Axis ;
               rdfs:comment "the metaphysical view determines the answer to the following question: is there such a thing as mind-independent, real moral facts?" .


###  http://www.github.com/silvialx/Onto/OntologicalSupposition
ex:OntologicalSupposition rdf:type owl:Class ;
                          rdfs:subClassOf ex:Supposition .


###  http://www.github.com/silvialx/Onto/Person
ex:Person rdf:type owl:Class .


###  http://www.github.com/silvialx/Onto/Philosopher
ex:Philosopher rdf:type owl:Class ;
               rdfs:subClassOf ex:Person .


###  http://www.github.com/silvialx/Onto/PhilosophyOfLanguage
ex:PhilosophyOfLanguage rdf:type owl:Class ;
                        rdfs:subClassOf ex:Axis ;
                        rdfs:comment "the linguistic view determines the answer to the following question: are propositions like \"is x good?\" truth-apt? Do those sentence prescribe a way the world ought to be?" .


###  http://www.github.com/silvialx/Onto/PhilosophyOfMind
ex:PhilosophyOfMind rdf:type owl:Class ;
                    rdfs:subClassOf ex:Axis ;
                    rdfs:comment "the philosophical view determines the answer to the following question: how do moral beliefs affect our reasoning about what to do?" .


###  http://www.github.com/silvialx/Onto/Representationalism
ex:Representationalism rdf:type owl:Class ;
                       rdfs:subClassOf ex:PhilosophyOfLanguage .


###  http://www.github.com/silvialx/Onto/Supposition
ex:Supposition rdf:type owl:Class .


###  http://www.github.com/silvialx/Onto/TruthAptness
ex:TruthAptness rdf:type owl:Class ;
                rdfs:subClassOf ex:PhilosophyOfLanguage .


###  http://www.github.com/silvialx/Onto/TruthTheorySupposition
ex:TruthTheorySupposition rdf:type owl:Class ;
                          rdfs:subClassOf ex:Supposition .


###  http://www.semanticweb.org/silvi/ontologies/2026/6/untitled-ontology-6#ConditionallyConsistentPosition
:ConditionallyConsistentPosition rdf:type owl:Class ;
                                 rdfs:subClassOf ex:ConsistentPosition .


###  http://www.semanticweb.org/silvi/ontologies/2026/6/untitled-ontology-6#InconsistentPosition
:InconsistentPosition rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ex:MetaethicalPosition
                                                                 [ rdf:type owl:Class ;
                                                                   owl:complementOf ex:ConsistentPosition
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ex:EvaluatedPosition .


#################################################################
#    Individuals
#################################################################

###  http://www.github.com/silvialx/Onto/AProjectivistStoryExplainsWhyWeTreatEvaluativeAndDescriptiveJudgmentsAsBound
ex:AProjectivistStoryExplainsWhyWeTreatEvaluativeAndDescriptiveJudgmentsAsBound rdf:type owl:NamedIndividual ,
                                                                                         <http://www.github.com/argumentsontology/Claim> ;
                                                                                rdfs:label "A projectivist/expressivist story about why we treat evaluative and descriptive judgments as bound together explains the supervenience relation more cheaply."@en .


###  http://www.github.com/silvialx/Onto/AbrahamsDilemma
ex:AbrahamsDilemma rdf:type owl:NamedIndividual ,
                            <http://www.github.com/argumentsontology/Argument> ;
                   <http://www.github.com/argumentsontology/negates> ex:DivineCommandTheory ;
                   rdfs:label "God's command towards Abraham to kill his own son leads to this dilemma: is it ever wrong to obey God?" .


###  http://www.github.com/silvialx/Onto/AbrahamsDilemmaResponse
ex:AbrahamsDilemmaResponse rdf:type owl:NamedIndividual ,
                                    <http://www.github.com/argumentsontology/Argument> ;
                           <http://www.github.com/argumentsontology/hasPremise> ex:GodIsTheSubjectOfEthics ,
                                                                                <http://www.github.com/silvialx/Onto/Excellence&HumanWellBeing> ;
                           <http://www.github.com/argumentsontology/supports> ex:DivineCommandTheory ;
                           argo:rebuts ex:AbrahamsDilemma ;
                           rdfs:label """God's command towards Abraham to kill his own son leads to this dilemma: is it ever wrong to obey God?
Adams' response argues that for sure something commanded by god cannot be morally wrong (Adams 1999, 283).""" .


###  http://www.github.com/silvialx/Onto/AbsenceOfASingleObjectiveMoralOrderExplainsDisagreementBetter
ex:AbsenceOfASingleObjectiveMoralOrderExplainsDisagreementBetter rdf:type owl:NamedIndividual ,
                                                                          <http://www.github.com/argumentsontology/Claim> ;
                                                                 rdfs:label "The absence of a single objective moral order better explains the depth and persistence of moral disagreement than widespread error does."@en .


###  http://www.github.com/silvialx/Onto/AbsentImplausibleCoincidenceThisUndercutsRealistJustification
ex:AbsentImplausibleCoincidenceThisUndercutsRealistJustification rdf:type owl:NamedIndividual ,
                                                                          <http://www.github.com/argumentsontology/Claim> ;
                                                                 rdfs:label "A coincidence between fitness-tracking and truth-tracking is highly implausible. This undercuts the justification for realist confidence in our moral beliefs (Street 2006, 122)."@en .


###  http://www.github.com/silvialx/Onto/Adams
ex:Adams rdf:type owl:NamedIndividual ,
                  ex:Philosopher ;
         <http://www.github.com/argumentsontology/supports> ex:DivineCommandTheory ;
         ex:created ex:AbrahamsDilemmaResponse ,
                    ex:FiniteAndInfiniteGoods ,
                    ex:MoralObligationImposedByCommands ;
         rdfs:seeAlso <http://www.wikidata.org/entity/Q5254926> .


###  http://www.github.com/silvialx/Onto/AkrasiaArgument
ex:AkrasiaArgument rdf:type owl:NamedIndividual ,
                            <http://www.github.com/argumentsontology/Argument> ;
                   <http://www.github.com/argumentsontology/hasConclusion> ex:MoralJudgmentsAreBeliefsNotAttitudes ;
                   <http://www.github.com/argumentsontology/hasPremise> ex:AkraticMotivationalFailure ,
                                                                        ex:NoncognitivismEntailsMotivationalGuarantee ,
                                                                        ex:SincereRightJudgmentPossible ;
                   <http://www.github.com/argumentsontology/negates> ex:BlackburnExpressivism ,
                                                                     ex:Emotivism ,
                                                                     ex:GibbardNormExpressivism ;
                   <http://www.github.com/argumentsontology/supports> ex:Cognitivist ;
                   rdfs:label "an agent can sincerely judge that an action is right yet fail, through weakness of will, to be motivated to do it; since noncognitivist theories tie the meaning of moral judgments to motivating attitudes, they struggle to make sense of this gap, which is better explained by treating moral judgments as beliefs that can fail to move us (an argument for cognitivism from akrasia)." .


###  http://www.github.com/silvialx/Onto/AkraticMotivationalFailure
ex:AkraticMotivationalFailure rdf:type owl:NamedIndividual ,
                                       <http://www.github.com/argumentsontology/Claim> ;
                              rdfs:label "That same agent can, through weakness of will, fail to be motivated to perform it."@en .


###  http://www.github.com/silvialx/Onto/Antirealist
ex:Antirealist rdf:type owl:NamedIndividual ,
                        ex:Metaphysics ;
               ex:isConditionallyCompatibleWith ex:QuasiRealist ;
               ex:isIncompatibleWith ex:Cognitivist ,
                                     ex:Coherentist ,
                                     ex:Empiricist ,
                                     ex:Intuitionist ,
                                     ex:NaturalRealism ,
                                     ex:NonnaturalRealism ,
                                     ex:Realist ;
               skos:definition "Antirealism is the negation of relaism. Consequently ethical facts are not \"out there\" as part of reality. Ethical facts are too different, too peculiar compared to what we think composes our reality." .


###  http://www.github.com/silvialx/Onto/Antirepresentationalist
ex:Antirepresentationalist rdf:type owl:NamedIndividual ,
                                    ex:Representationalism ;
                           owl:differentFrom ex:Representationalist ;
                           ex:isIncompatibleWith ex:Empiricist ,
                                                 ex:NaturalRealism ,
                                                 ex:NonnaturalRealism ,
                                                 ex:Representationalist ;
                           skos:definition "Antirepresentationalism holds that statements such as \"murder is wrong\" prescribe a way reality ought to be, even if it isn't like that." .


###  http://www.github.com/silvialx/Onto/ArgumentFromDisagreement
ex:ArgumentFromDisagreement rdf:type owl:NamedIndividual ,
                                     <http://www.github.com/argumentsontology/Argument> ;
                            <http://www.github.com/argumentsontology/hasConclusion> ex:NoSingleObjectiveMoralOrderBestExplainsMoralDisagreement ;
                            <http://www.github.com/argumentsontology/hasPremise> ex:AbsenceOfASingleObjectiveMoralOrderExplainsDisagreementBetter ,
                                                                                 ex:MoralDisagreementIsDeepAndIntractableAcrossCulturesAndHistory ,
                                                                                 ex:RealismMustExplainDisagreementAsWidespreadError ;
                            <http://www.github.com/argumentsontology/negates> ex:Nonnaturalism ,
                                                                              ex:Realist ;
                            <http://www.github.com/argumentsontology/supports> ex:ErrorTheory ,
                                                                               ex:Relativism ;
                            rdfs:label "the depth and intractability of moral disagreement across cultures and history is better explained by there being no single objective moral order than by widespread error on the part of the disputants (Mackie)." .


###  http://www.github.com/silvialx/Onto/Aristotle
ex:Aristotle rdf:type owl:NamedIndividual ,
                      ex:Philosopher ;
             ex:created ex:AkrasiaArgument ,
                        ex:NicomacheanEthics ;
             rdfs:seeAlso <http://www.wikidata.org/entity/Q868> .


###  http://www.github.com/silvialx/Onto/Ayer
ex:Ayer rdf:type owl:NamedIndividual ,
                 ex:Philosopher ;
        ex:created :LanguageTruthAndLogicCh6 ;
        rdfs:seeAlso <http://www.wikidata.org/entity/Q243757> .


###  http://www.github.com/silvialx/Onto/BeliefsTrueOnlyByAccidentDoNotConstituteKnowledge
ex:BeliefsTrueOnlyByAccidentDoNotConstituteKnowledge rdf:type owl:NamedIndividual ,
                                                              <http://www.github.com/argumentsontology/Claim> ;
                                                     rdfs:label "A true belief that only accidentally tracks the fact it is about does not constitute knowledge."@en .


###  http://www.github.com/silvialx/Onto/Blackburn
ex:Blackburn rdf:type owl:NamedIndividual ,
                      ex:Philosopher ;
             <http://www.github.com/argumentsontology/supports> ex:BlackburnExpressivism ;
             ex:created ex:SupervenienceArgument ,
                        ex:SecuringTheKnots:MoralEpistemologyForTheQuasiRealist ;
             rdfs:comment "The \"truthAptness\" predicate and the \"externalism\" predicate assume a minimalist conception of truth." ;
             rdfs:seeAlso <http://www.wikidata.org/entity/Q287357> .


###  http://www.github.com/silvialx/Onto/BlackburnExpressivism
ex:BlackburnExpressivism rdf:type owl:NamedIndividual ,
                                  ex:ConsistentPosition ,
                                  ex:Expressivism ;
                         ex:actionMotivationSupposition ex:Internalist ;
                         ex:cognitivistSupposition ex:Noncognitivist ;
                         ex:epistemicSupposition ex:QuasiRealist ;
                         ex:necessaryCondition ex:truthMinimalism ;
                         ex:representationSupposition ex:Antirepresentationalist ;
                         rdfs:comment "" .


###  http://www.github.com/silvialx/Onto/Boyd
ex:Boyd rdf:type owl:NamedIndividual ,
                 ex:Philosopher ;
        <http://www.github.com/argumentsontology/supports> ex:NonReductiveNaturalism ;
        ex:created ex:HowToBeAMoralRealist ,
                   ex:SimilaritiesInMoralityAndScience ;
        rdfs:seeAlso <http://www.wikidata.org/entity/Q974723> .


###  http://www.github.com/silvialx/Onto/Brink
ex:Brink rdf:type owl:NamedIndividual ,
                  ex:Philosopher ;
         <http://www.github.com/argumentsontology/supports> ex:NonReductiveNaturalism ;
         ex:created :MoralRealismAndTheFoundationsOfEthics ;
         rdfs:seeAlso <http://www.wikidata.org/entity/Q21903486> .


###  http://www.github.com/silvialx/Onto/CognitiveCommandImplication
ex:CognitiveCommandImplication rdf:type owl:NamedIndividual ,
                                        <http://www.github.com/argumentsontology/Argument> ;
                               <http://www.github.com/argumentsontology/hasPremise> :CognitiveCommand ,
                                                                                    :TruismOfSentencesAndTheirTruth ;
                               <http://www.github.com/argumentsontology/supports> ex:QuietistMetaethics ;
                               rdfs:label "When one appraises the claim that a sentence S is true and  holds an opinion about its content, divergent appraisals may turn in divergent opinions. But when such differences fail of Cognitive Command, therefore no inputs are different between the subjects holding these opinions, and no cognitive shortcoming need be involved for such difference of opinion, the same kind of divergence can be held for S's truth value. Therefore, in such cases, minimalism about meaning has to involve minimalism about metalinguistic ascriptions of truth (Wright 1992, 222)." .


###  http://www.github.com/silvialx/Onto/Cognitivist
ex:Cognitivist rdf:type owl:NamedIndividual ,
                        ex:Cognitivism ;
               owl:differentFrom ex:Noncognitivist ;
               ex:isIncompatibleWith ex:NonTruthApt ,
                                     ex:QuasiRealist ;
               skos:definition "the mental states expressed by ethical statements are belief about what the wourld should be." .


###  http://www.github.com/silvialx/Onto/Coherentist
