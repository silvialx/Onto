                                <http://www.github.com/argumentsontology/hasConclusion> ex:ThereIsNoGoodReasonToBelieveMoralFactsExist ;
                                <http://www.github.com/argumentsontology/hasPremise> ex:MoralFactsNeverFeatureInTheBestExplanationOfAnyObservation ,
                                                                                     ex:PositsThatNeverExplainAnythingGiveNoReasonToBelieveInThem ,
